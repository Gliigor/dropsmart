# Optional but recommended: real walking routes (free key at openrouteservice.org).
# Without it, walking times are straight-line estimates and the UI says so.
ORS_API_KEY=your_openrouteservice_api_key

# Optional: self-hosted OSRM. The public demo server is fine for light use only.
# OSRM_URL=https://router.project-osrm.org

# Optional analytics (Supabase). The app works without them.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
ADMIN_SECRET_KEY=your_admin_password

NEXT_PUBLIC_APP_URL=https://gligor.xyz
